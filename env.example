# Copy to env.sh, fill in, then:  source env.sh      (env.sh is in .gitignore; no key is in this repository)

# Required
export FREYA_API_KEY=fak_your_key_here                 # your Freya workspace, under API keys. The agent is saved to this workspace.
export FREYA_API_URL=https://staging-app.freyavoice.ai
export ANTHROPIC_API_KEY=sk-ant-your_key_here          # the builder's model calls (Claude Opus builds, a smaller Claude model plays the test calls)

# Optional
# export FREYA_WORKSPACE_ID=...                        # only when the Freya key sees more than one workspace; default is the first
# export BUILD_BUDGET_SECONDS=3600                     # time budget of one run; default 60 minutes (same as --budget-minutes 60)
# export FREYA_BANK_TEAM_KEY=any-secret-of-16-or-more  # only for --test-on platform against the kit's practice bank; not used by the default run
